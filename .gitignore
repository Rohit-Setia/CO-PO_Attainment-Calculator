# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
jspm_packages/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Environment & secrets (NEVER commit real credentials) ────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Logs & diagnostics ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ── Test coverage ────────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output
lib-cov

# ── Database backups & dumps (keep OUTSIDE git) ──────────────────────────────
backups/
db-backups/
*.dump
*.sql.gz
# Local scratch dumps only — do NOT ignore versioned .sql files inside Backend/
# (none are used today; migrations live in JS under Backend/models/).

# ── AI assistant / editor worktree artifacts ─────────────────────────────────
.claude/
.cline/
.cursor/
.aider*
.windsurf/
.vscode/
.idea/
*.swp
*.swo

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
~$*

# ── Runtime/misc ─────────────────────────────────────────────────────────────
pids
*.pid
*.seed
*.pid.lock
.cache/
.parcel-cache/
.vite/
*.tgz
.node_repl_history
.eslintcache
.stylelintcache
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
