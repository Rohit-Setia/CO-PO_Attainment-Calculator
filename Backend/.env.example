# Database settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=teacher_auth

# Optional DB port
DB_PORT=3306

# JWT secret (replace in production)
JWT_SECRET=replace_this_with_a_strong_secret

# Bcrypt salt rounds (optional)
BCRYPT_SALT_ROUNDS=10

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000
