# ─────────────────────────────────────────────────────────────────────────────
# CT University OBE ERP — Backend environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# MySQL connection (the application uses mysql2/promise — MySQL 8 or MariaDB 10.5+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=teacher_auth
DB_SSL=false
# Optional cloud/provider TLS settings.
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000

# HTTP
PORT=5000
# Comma-separated list of allowed browser origins (CORS allowlist).
CLIENT_URL=http://localhost:5173

# JWT — REQUIRED. Production refuses to start if this is missing or < 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-long-random-secret-at-least-32-characters

# ── SMTP (credential email, password-setup links) ───────────────────────────
# Gmail example — for production prefer a transactional provider or your campus SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-college.edu
SMTP_PASSWORD=change-me
SMTP_FROM=CT University OBE ERP <no-reply@your-college.edu>
# Envelope control: when false (default) credential emails are only logged, never sent.
# Set to true once real SMTP credentials are configured.
SMTP_ENABLED=false

# ── Password-setup / reset ──────────────────────────────────────────────────
PASSWORD_RESET_EXPIRY_HOURS=24
# Base URL the frontend uses to render the "set your password" page.
PASSWORD_RESET_URL=http://localhost:5173/set-password

# ── Question paper uploads ──────────────────────────────────────────────────
# Directory (relative to Backend/) where uploaded question papers are stored.
UPLOAD_DIR=uploads
# Maximum accepted upload size in MB.
MAX_UPLOAD_MB=15

# ── Optional AI enrichment (CO / Bloom detection) ───────────────────────────
# When unset, the built-in keyword/heuristic engine is used (works offline).
# When set, the analysis service can call an OpenAI-compatible endpoint for richer
# suggestions. NEVER compile these into the frontend — backend env only.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini