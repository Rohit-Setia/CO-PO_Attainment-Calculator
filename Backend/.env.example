# ─────────────────────────────────────────────────────────────────────────────
# CT University OBE ERP — Backend environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# MySQL connection (the application uses mysql2/promise — MySQL 8 or MariaDB 10.5+).
# Aiven MySQL is the ONLY database for this project — every developer connects to the
# SAME managed instance (there is no per-developer local MySQL). Ask a teammate for the
# real DB_HOST/DB_PORT/DB_USER/DB_PASSWORD and the aiven-ca.pem file; never invent your own.
DB_HOST=your-service-name.aivencloud.com
DB_PORT=changeme
DB_USER=avnadmin
DB_PASSWORD=change-me
DB_NAME=defaultdb
# Aiven requires TLS. Do not set DB_SSL=false or DB_SSL_REJECT_UNAUTHORIZED=false.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Download the Aiven CA certificate from the Aiven console and place it at this path
# (relative to Backend/); it is gitignored and must never be committed.
DB_SSL_CA_FILE=certs/aiven-ca.pem
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000

# HTTP
PORT=5000
# Comma-separated list of allowed browser origins (CORS allowlist).
CLIENT_URL=http://localhost:5173

# JWT — REQUIRED. Production refuses to start if this is missing or < 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-long-random-secret-at-least-32-characters

# ── SMTP (credential email, password-setup links) ───────────────────────────
# Gmail example — for production prefer a transactional provider or your campus SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-college.edu
SMTP_PASSWORD=change-me
SMTP_FROM=CT University OBE ERP <no-reply@your-college.edu>
# Envelope control: when false (default) credential emails are only logged, never sent.
# Set to true once real SMTP credentials are configured.
SMTP_ENABLED=false

# ── Password-setup / reset ──────────────────────────────────────────────────
PASSWORD_RESET_EXPIRY_HOURS=24
# Base URL the frontend uses to render the "set your password" page.
PASSWORD_RESET_URL=http://localhost:5173/set-password
# Anti-abuse: max forgot/reset-password requests per IP per 15 minutes.
PASSWORD_RESET_RATE_LIMIT=5

# ── Question paper uploads ──────────────────────────────────────────────────
# Directory (relative to Backend/) where uploaded question papers are stored.
UPLOAD_DIR=uploads
# Maximum accepted upload size in MB.
MAX_UPLOAD_MB=15

# ── Optional AI suggestions for question papers (CO / RBT) ──────────────────
# Used only for questions whose uploaded paper does NOT print a CO or RBT level, and only
# when the Examination Cell clicks "Suggest with AI" on the Auto-Mapping Review screen.
# A suggestion is never applied until a reviewer accepts it. When unset, the built-in
# keyword engine is used instead (works offline; nothing leaves the server).
# Confidentiality: enabling this sends unreleased question text and the course's CO
# descriptions to the endpoint below — use a provider your university has approved.
# Any OpenAI-compatible chat-completions endpoint works. Backend env only — NEVER
# compile these into the frontend.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=45000