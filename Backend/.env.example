# Copy this file to .env and fill in real values. Never commit the real .env.

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=teacher_auth

# Required. Signs and verifies login JWTs — the server refuses to start without this set.
# In production, use a random value at least 32 characters long.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin(s) allowed to call this API, comma-separated for multiple (e.g. staging + prod).
# In production (NODE_ENV=production), ONLY these origins are accepted.
CLIENT_URL=http://localhost:5173

# Port the Express server listens on.
PORT=5000

# Production mode. Set to "production" to enable production-only guards:
#  - CORS localhost bypass disabled
#  - JWT_SECRET length warning if < 32 characters
# NODE_ENV=production
