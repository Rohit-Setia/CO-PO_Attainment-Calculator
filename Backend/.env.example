# Copy this file to .env and fill in real values. Never commit the real .env.

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=teacher_auth

# Required. Signs and verifies login JWTs — the server refuses to start without this set.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin(s) allowed to call this API, comma-separated for multiple (e.g. staging + prod).
CLIENT_URL=http://localhost:5173

# Port the Express server listens on.
PORT=5000
